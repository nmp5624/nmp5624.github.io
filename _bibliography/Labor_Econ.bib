@inproceedings{ohi2020,
   title={Corporal Punishment, Child Development and Household Labor Supply (2026)},
   author={Nikita Pavlov},
   abstract={This paper studies how corporal punishment affects child development and household resource allocation. I develop and estimate a dynamic model in which parents and children interact strategically. Child’s human capital is assumed to feature two dimensions: cognitive capital and mental stability. The model separates the disciplinary role of punishment from its developmental costs. Counterfactual simulations of a ban on the corporal-punishment scheme imply large gains in children’s mental stability, especially for children who would otherwise face positive punishment risk. Effects on cognitive capital differ between households. In particular, cognitive capital increases when parents are able to substitute toward non-violent supervision, but falls when the ban removes a disciplinary instrument without generating a compensating increase in productive inputs. However, replacing corporal punishment with more parental involvement reduces maternal labor supply and household income.},
   booktitle={Job Market Paper},
   year={},
   pdf={JMP_October.pdf},
}
@inproceedings{ohi2020,
   title={Government Transfers, Parental Incentives and Child Development (2026)},
   author={Nikita Pavlov, Ewout Verriest},
   abstract={We leverage a model of parental and child investments in the cognitive and non-cognitive development of children, to explore the impact of various government income transfer policies. We find that if the planner's objective is to improve the distribution of cognitive skills, the most effective set of policies are (external) conditional cash transfers, in which the household receives an income transfer when the child's cognitive ability exceeds a prespecified threshold. We find that the possibility of parents using their own extrinsic reward schemes to incentivize their child (or internal conditional cash transfers) greatly increases the cost effectiveness of external conditional cash transfer policies in fostering cognitive skills, but that they also create non-trivial negative feedback effects of monetary transfers (both internal or external) on children's discount factors.},
   booktitle={Working Paper},
   year={},
   pdf={verriest_pavlov_transfers.pdf},
}
@inproceedings{cisse2016adios,
   title={From Rules to Hugs: The Impact of Parental Strictness and
Warmth on Juvenile’s Time Allocation (2023)},
   author={Nikita Pavlov},
   abstract={In this paper, I study the effects of parental strictness and warmth on juveniles' time allocation and human capital formation. I build a structural model where a juvenile solves a time allocation problem by choosing how much time to spend on studying, delinquent leisure, and regular leisure. Her returns from studying
   and delinquent leisure depend on corresponding dimensions of human capital, namely educational capital and delinquent capital. I assume that parental strictness and warmth are capital inputs and use instrumental variables (IV) to estimate their impact on the corresponding measures of human capital. My estimates suggest that warmth has a strong positive
   impact on educational capital, whereas strictness has a strong negative impact on delinquent capital. Simulations reveal that although warmth does not discourage delinquent leisure as much as strictness does, it greatly incentivizes studying both through a direct effect on educational capital and through emerging time substitution patterns.
   At the same time, the strong decrease in delinquent leisure induced by strictness is compensated mostly by an increase in regular leisure rather than studying. The implications of these results for human capital formation are discussed.},
   booktitle={3rd Year Paper},
   year={},
   pdf={Rules_to_Hugs.pdf},
}
