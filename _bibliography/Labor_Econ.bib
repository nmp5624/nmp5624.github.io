@inproceedings{ohi2020,
   title={Corporal Punishment, Child Development and Household Labor Supply (2025)},
   author={Nikita Pavlov},
   abstract={I develop and estimate a dynamic model of child human capital formation that embeds parents’ option
to implement a corporal-punishment (CP) scheme within the household’s intertemporal time budget and laborsupply problem. Parents allocate time budget across productive time with the child, leisure, and market work; the
child acts as a Stackelberg follower, allocating time to self-investment, regular leisure, and non-compliant leisure
(misbehavior). If adopted, the CP scheme governs realized punishment via a Poisson process whose intensity is
proportional to non-compliant leisure. The scheme deters misbehavior but can harm the child’s cognitive capital
and mental stability capital — two age-dependent, interrelated human-capital dimensions that enter both the
parents’ and the child’s utilities. As an alternative to CP, parents can discourage misbehavior by spending more
time with the child, thereby tightening the child’s time budget; this comes at the cost of foregone leisure and work
hours, creating a non-trivial parenting-style trade-off. The model allows for rich heterogeneity in parental and child
preferences and in labor-market opportunities across households, addressing selection on both sides. I estimate
the model by the Method of Simulated Moments using the PSID (1986–2007) dataset. Counterfactual bans of
CP indicate average gains of 0.12σ in final mental-stability capital among previously exposed children, rising to
0.20σ for those who also received physical punishment. The ban reduces mothers’ labor-force participation by 4%
and, among stayers, cuts median hours by 14%, lowering median household income by 3.8%; fathers’ participation
changes are negligible. Effects on cognitive capital are heterogeneous and often ambiguous, reflecting offsets between the ban’s direct benefits and indirect losses from reduced child self-investment and household income. Policy
implications favor pairing CP restrictions with supports that preserve parental time and earnings.},
   booktitle={Prospective Job Market Paper. First draft coming soon!},
   year={},
}

@inproceedings{ohi2020,
   title={Household Transfers and Child Development: Effects on Cognitive and Non-Cognitive Skill Formation (2025)},
   author={Nikita Pavlov and Ewout Verriest},
   abstract={Using the DFVW (2025) dynamic model of child human-capital formation, we compare transfer designs and their effects on children’s cognitive and non-cognitive skills. We contrast restricted transfers that must be spent on child-specific consumption with unrestricted cash given to parents, under both conditional and unconditional regimes. 
Across both regimes, restricted transfers yield larger gains in cognitive skills than unrestricted cash. However, these gains can come at a cost to non-cognitive skills when policies 
introduce strong extrinsic incentives that, in the model, depress the child’s effective discount factor and crowd out intrinsic motivation. 
Counterfactual simulations delineate when restricted transfers and conditionality raise cognitive achievement without eroding non-cognitive development, 
and inform policy design that balances improvements in cognition with the preservation of socio-emotional skills.},
   booktitle={First draft coming soon!},
   year={},
}

@inproceedings{cisse2016adios,
   title={From Rules to Hugs: The Impact of Parental Strictness and
Warmth on Juvenile’s Time Allocation (2023)},
   author={Nikita Pavlov},
   abstract={In this paper, I study the effects of parental strictness and warmth on juveniles' time allocation and human capital formation. I build a structural model where a juvenile solves a time allocation problem by choosing how much time to spend on studying, delinquent leisure, and regular leisure. Her returns from studying
   and delinquent leisure depend on corresponding dimensions of human capital, namely educational capital and delinquent capital. I assume that parental strictness and warmth are capital inputs and use instrumental variables (IV) to estimate their impact on the corresponding measures of human capital. My estimates suggest that warmth has a strong positive
   impact on educational capital, whereas strictness has a strong negative impact on delinquent capital. Simulations reveal that although warmth does not discourage delinquent leisure as much as strictness does, it greatly incentivizes studying both through a direct effect on educational capital and through emerging time substitution patterns.
   At the same time, the strong decrease in delinquent leisure induced by strictness is compensated mostly by an increase in regular leisure rather than studying. The implications of these results for human capital formation are discussed.},
   booktitle={3rd Year Paper},
   year={},
   pdf={Rules_to_Hugs.pdf},
}
